<section class="grid gap-6">
  <div class="flex flex-col justify-between gap-4 rounded-md bg-teal-900 px-6 py-8 text-white sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-100">Agendamento psicológico</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-normal">Consultas Psicológicas - Unilavras</h1>
      <p class="mt-3 max-w-2xl text-teal-50">Organize a agenda clínica, acompanhe supervisões e evite conflitos de horário entre estagiários e professores.</p>
    </div>
    <% if estagiario_actor? %>
      <%= link_to "Nova consulta", new_consulta_path, class: "inline-flex items-center justify-center rounded-md bg-white px-4 py-2 text-sm font-semibold text-teal-900 shadow-sm hover:bg-teal-50" %>
    <% elsif professor_actor? %>
      <span class="inline-flex items-center justify-center rounded-md bg-white/10 px-4 py-2 text-sm font-semibold text-white">Visão do professor</span>
    <% end %>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-md border border-slate-200 bg-white p-5">
      <div class="text-sm font-medium text-slate-500">Consultas</div>
      <div class="mt-2 text-3xl font-semibold"><%= @consultas_count %></div>
    </div>
    <div class="rounded-md border border-slate-200 bg-white p-5">
      <div class="text-sm font-medium text-slate-500">Confirmadas</div>
      <div class="mt-2 text-3xl font-semibold"><%= @confirmed_count %></div>
    </div>
    <div class="rounded-md border border-slate-200 bg-white p-5">
      <div class="text-sm font-medium text-slate-500">Professores ativos</div>
      <div class="mt-2 text-3xl font-semibold"><%= @professores_count %></div>
    </div>
  </div>

  <div class="rounded-md border border-slate-200 bg-white">
    <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
      <h2 class="text-base font-semibold">Próximas consultas</h2>
      <%= link_to "Ver agenda", consultas_path, class: "text-sm font-semibold text-teal-700 hover:text-teal-900" %>
    </div>
    <div class="divide-y divide-slate-100">
      <% if @upcoming_consultas.any? %>
        <% @upcoming_consultas.each do |consulta| %>
          <%= link_to consulta_path(consulta), class: "grid gap-2 px-5 py-4 hover:bg-slate-50 md:grid-cols-[1fr_auto]" do %>
            <div>
              <div class="font-semibold text-slate-950"><%= consulta.patient_name %></div>
              <div class="mt-1 text-sm text-slate-500"><%= consulta.professor.name %> · <%= consulta.estagiario.name %></div>
            </div>
            <div class="text-sm font-medium text-slate-600"><%= l consulta.starts_at, format: :short %></div>
          <% end %>
        <% end %>
      <% else %>
        <div class="px-5 py-8 text-sm text-slate-500">Nenhuma consulta futura encontrada.</div>
      <% end %>
    </div>
  </div>
</section>
