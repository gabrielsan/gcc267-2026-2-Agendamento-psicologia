<% mensagens = Array(local_assigns[:messages].presence || local_assigns[:record]&.errors&.full_messages).uniq %>
<% if mensagens.any? %>
  <div class="error-summary" role="alert" tabindex="-1">
    <h2>Não foi possível salvar</h2>
    <ul><% mensagens.each do |mensagem| %><li><%= mensagem %></li><% end %></ul>
  </div>
<% end %>
