<% content_for :title, "Visão geral" %>
<div class="topline"><span>Seu espaço de cuidado</span><span><%= l(Date.current, format: "%d de %B de %Y") %></span></div>
<header class="page-header"><div><span class="eyebrow">VISÃO GERAL</span><h1>Olá, <%= current_usuario.nome.split.first %>.</h1><p><%= current_usuario.admin? ? "Tudo o que você precisa para organizar a clínica." : current_usuario.professor? ? "Acompanhe os atendimentos sob sua supervisão." : "Sua rotina de atendimentos, com mais clareza." %></p></div><% if policy(Consulta).create? %><%= link_to new_consulta_path, class: "btn btn-primary" do %><%= icone("mais") %> Nova consulta<% end %><% elsif current_usuario.admin? %><%= link_to "Novo professor", new_professor_path, class: "btn btn-primary" %><% end %></header>
<div class="stats-grid"><% [["agenda", "Consultas hoje", @hoje, "Na sua área de acesso"], ["relogio", "A confirmar", @pendentes, "Agendamentos futuros"], ["check", "Realizadas", @realizadas, "Histórico de atendimentos"]].each do |icon, title, number, hint| %><article class="stat-card"><div><span><%= title %></span><%= icone(icon) %></div><strong><%= number %></strong><small><%= hint %></small></article><% end %></div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><span class="eyebrow">PRÓXIMOS ENCONTROS</span><h2><%= current_usuario.estagiario? ? "Minha agenda" : current_usuario.professor? ? "Consultas supervisionadas" : "Agenda da clínica" %></h2></div><%= link_to "Ver todas →", consultas_path, class: "text-link" %></div>
  <% if @proximas.any? %><div class="appointment-list"><%= render partial: "consultas/consulta", collection: @proximas %></div><% else %><%= render "shared/empty", title: "Sua agenda está livre", message: "As próximas consultas em aberto aparecerão aqui." %><% end %>
</section><aside class="dashboard-aside"><section class="care-card"><span class="eyebrow">CADA ENCONTRO IMPORTA</span><h2>Tempo para ouvir.<br>Espaço para acolher.</h2><p>Mantenha os registros atualizados para um acompanhamento mais próximo.</p><span class="care-symbol" aria-hidden="true">ψ</span></section><section class="panel quick-panel"><h2>Seu perfil</h2><p><strong><%= perfil_nome %></strong></p><% if current_usuario.estagiario? %><p class="muted">Supervisão de <%= current_usuario.supervisor.nome %></p><% elsif current_usuario.admin? %><p class="muted"><%= @professores_ativos %> professores ativos</p><%= link_to "Gerenciar professores →", professores_path, class: "text-link" %><% else %><p class="muted">Visualize e acompanhe as consultas dos seus supervisionados.</p><% end %></section></aside></div>
