<div class="mx-auto max-w-4xl rounded-md border border-slate-200 bg-white p-6">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-teal-700"><%= @consulta.status.humanize %></p>
      <h1 class="mt-2 text-2xl font-semibold"><%= @consulta.patient_name %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= l @consulta.starts_at, format: :long %> até <%= l @consulta.ends_at, format: :short %></p>
    </div>
    <div class="flex gap-2">
      <% if estagiario_actor? && @consulta.estagiario_id == current_estagiario.id %>
        <%= link_to "Editar", edit_consulta_path(@consulta), class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold hover:bg-slate-50" %>
      <% end %>
      <% if admin_actor? %>
        <%= button_to "Excluir", @consulta, method: :delete, class: "rounded-md bg-rose-600 px-3 py-2 text-sm font-semibold text-white hover:bg-rose-700" %>
      <% end %>
    </div>
  </div>

  <dl class="mt-8 grid gap-4 sm:grid-cols-2">
    <div><dt class="text-sm text-slate-500">Professor</dt><dd class="mt-1 font-medium"><%= @consulta.professor.name %></dd></div>
    <div><dt class="text-sm text-slate-500">Estagiário</dt><dd class="mt-1 font-medium"><%= @consulta.estagiario.name %></dd></div>
    <div><dt class="text-sm text-slate-500">Modalidade</dt><dd class="mt-1 font-medium"><%= @consulta.modality.humanize %></dd></div>
    <div><dt class="text-sm text-slate-500">Sala</dt><dd class="mt-1 font-medium"><%= @consulta.room.presence || "-" %></dd></div>
    <div><dt class="text-sm text-slate-500">E-mail</dt><dd class="mt-1 font-medium"><%= @consulta.patient_email.presence || "-" %></dd></div>
    <div><dt class="text-sm text-slate-500">Telefone</dt><dd class="mt-1 font-medium"><%= @consulta.patient_phone.presence || "-" %></dd></div>
  </dl>

  <div class="mt-8 grid gap-5">
    <div><h2 class="text-sm font-semibold text-slate-700">Observações</h2><p class="mt-2 whitespace-pre-line text-sm text-slate-600"><%= @consulta.notes.presence || "Sem observações." %></p></div>
    <div><h2 class="text-sm font-semibold text-slate-700">Supervisão</h2><p class="mt-2 whitespace-pre-line text-sm text-slate-600"><%= @consulta.supervision_notes.presence || "Sem notas de supervisão." %></p></div>
  </div>
</div>
