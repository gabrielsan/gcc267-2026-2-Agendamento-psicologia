<% content_for :title, "Detalhes da consulta" %>
<%= link_to "← Voltar às consultas", consultas_path, class: "back-link" %><header class="page-header"><div><span class="eyebrow">DETALHES DO ATENDIMENTO</span><h1><%= @consulta.paciente_nome %></h1><p>Consulta #<%= @consulta.id %></p></div><%= status_badge(@consulta.status) %></header>
<section class="panel detail-panel"><dl class="detail-grid"><div><dt>Início</dt><dd><%= data_hora(@consulta.inicio) %></dd></div><div><dt>Fim</dt><dd><%= data_hora(@consulta.fim) %></dd></div><div><dt>Sala</dt><dd><%= @consulta.sala %></dd></div><div><dt>Duração</dt><dd><%= @consulta.duracao_em_minutos %> minutos</dd></div><div><dt>Estudante responsável</dt><dd><%= @consulta.estagiario.nome %></dd></div><div><dt>Professor supervisor</dt><dd><%= @consulta.professor.nome %></dd></div><div><dt>E-mail do paciente</dt><dd><%= @consulta.paciente_email.presence || "Não informado" %></dd></div><div><dt>Telefone do paciente</dt><dd><%= @consulta.paciente_telefone.presence || "Não informado" %></dd></div></dl><div class="detail-notes"><h2>Observações</h2><%= simple_format(@consulta.observacoes.presence || "Nenhuma observação registrada.") %></div><div class="form-actions"><% if policy(@consulta).update? %><%= link_to "Editar consulta", edit_consulta_path(@consulta), class: "btn btn-primary" %><% end %><% if policy(@consulta).destroy? %><%= button_to "Excluir consulta", consulta_path(@consulta), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Excluir esta consulta? Esta ação não pode ser desfeita." } } %><% end %></div></section>
