<article class="appointment"><div class="appointment-date"><strong><%= consulta.inicio.day %></strong><span><%= l(consulta.inicio, format: "%b").upcase %></span></div><div class="appointment-info"><%= link_to consulta.paciente_nome, consulta_path(consulta), class: "appointment-name", data: { turbo_frame: "_top" } %><p><%= consulta.inicio.strftime("%H:%M") %>–<%= consulta.fim.strftime("%H:%M") %> <span>·</span> <%= consulta.sala %></p><small><%= consulta.estagiario.nome %> · Sup. <%= consulta.professor.nome %></small></div><div class="appointment-side"><%= status_badge(consulta.status) %><%= link_to "Ver consulta →", consulta_path(consulta), class: "text-link", data: { turbo_frame: "_top" }, aria: { label: "Ver consulta de #{consulta.paciente_nome}" } %></div></article>
