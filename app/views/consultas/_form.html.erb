<% if consulta.errors.any? %>
  <div class="mb-5 rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
    <strong>Revise os dados:</strong> <%= consulta.errors.full_messages.to_sentence %>
  </div>
<% end %>

<%= form_with model: consulta, class: "grid gap-5" do |form| %>
  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <%= form.label :patient_name, "Paciente", class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :patient_name, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
    <div>
      <%= form.label :professor_id, "Professor supervisor", class: "block text-sm font-medium text-slate-700" %>
      <%= form.collection_select :professor_id, @professores, :id, :name, { prompt: "Selecione" }, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
    <div>
      <%= form.label :patient_email, "E-mail do paciente", class: "block text-sm font-medium text-slate-700" %>
      <%= form.email_field :patient_email, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
    <div>
      <%= form.label :patient_phone, "Telefone", class: "block text-sm font-medium text-slate-700" %>
      <%= form.telephone_field :patient_phone, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
    <div>
      <%= form.label :starts_at, "Início", class: "block text-sm font-medium text-slate-700" %>
      <%= form.datetime_field :starts_at, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
    <div>
      <%= form.label :ends_at, "Fim", class: "block text-sm font-medium text-slate-700" %>
      <%= form.datetime_field :ends_at, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
    <div>
      <%= form.label :modality, "Modalidade", class: "block text-sm font-medium text-slate-700" %>
      <%= form.select :modality, Consulta.modalities.keys.map { |key| [key.humanize, key] }, {}, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
    <div>
      <%= form.label :status, "Status", class: "block text-sm font-medium text-slate-700" %>
      <%= form.select :status, Consulta.statuses.keys.map { |key| [key.humanize, key] }, {}, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
    <div>
      <%= form.label :room, "Sala", class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :room, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
    </div>
  </div>
  <div>
    <%= form.label :notes, "Observações", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_area :notes, rows: 4, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
  </div>
  <div>
    <%= form.label :supervision_notes, "Notas de supervisão", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_area :supervision_notes, rows: 3, class: "mt-1 w-full rounded-md border-slate-300 shadow-sm focus:border-teal-600 focus:ring-teal-600" %>
  </div>
  <div class="flex gap-3">
    <%= form.submit "Salvar consulta", class: "rounded-md bg-teal-700 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" %>
    <%= link_to "Cancelar", consultas_path, class: "rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>
<% end %>
