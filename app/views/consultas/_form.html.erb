<div class="form-layout"><section class="panel form-panel"><%= render "shared/errors", record: @consulta, messages: @erros %>
<%= form_with model: @consulta, class: "form-stack" do |f| %>
  <% unless current_usuario.professor? %>
    <fieldset><legend>Dados do paciente</legend><div class="form-grid"><div class="field full"><%= f.label :paciente_nome, "Nome do paciente" %><%= f.text_field :paciente_nome, required: true, maxlength: 120, autocomplete: "off" %></div><div class="field"><%= f.label :paciente_email, "E-mail do paciente" %><%= f.email_field :paciente_email, autocomplete: "off" %></div><div class="field"><%= f.label :paciente_telefone, "Telefone do paciente" %><%= f.telephone_field :paciente_telefone, maxlength: 20, autocomplete: "off" %></div></div></fieldset>
    <fieldset><legend>Horário e local</legend><div class="form-grid"><div class="field"><%= f.label :inicio, "Início" %><%= f.datetime_local_field :inicio, required: true %></div><div class="field"><%= f.label :fim, "Fim" %><%= f.datetime_local_field :fim, required: true %></div><div class="field full"><%= f.label :sala, "Sala" %><%= f.text_field :sala, required: true, maxlength: 50, placeholder: "Ex.: Sala 1" %></div>
    <% if current_usuario.admin? && @consulta.persisted? %><div class="field full"><%= f.label :estagiario_id, "Estudante responsável" %><%= f.collection_select :estagiario_id, Estagiario.order(:nome), :id, :nome %></div><% end %></div></fieldset>
  <% end %>
  <fieldset><legend>Acompanhamento</legend><div class="form-stack"><% if @consulta.persisted? %><div class="field"><%= f.label :status, "Status" %><%= f.select :status, status_para_formulario(@consulta) %></div><% end %><div class="field"><%= f.label :observacoes, "Observações" %><%= f.text_area :observacoes, rows: 4, placeholder: "Registre as informações necessárias ao atendimento." %></div></div></fieldset>
  <div class="form-actions"><%= f.submit "Salvar consulta", class: "btn btn-primary", data: { turbo_submits_with: "Salvando…" } %><%= link_to "Cancelar", @consulta.persisted? ? consulta_path(@consulta) : consultas_path, class: "btn btn-secondary" %></div>
<% end %></section><aside class="form-aside"><span class="profile-icon"><%= icone("relogio") %></span><h2>Antes de salvar</h2><p>O atendimento deve durar entre 30 minutos e 2 horas.</p><p>Os horários são exibidos no fuso de Brasília. Conflitos de sala ou estudante serão informados ao salvar.</p><% if current_usuario.professor? %><p>Seu perfil permite atualizar o status e as observações das consultas supervisionadas.</p><% else %><p>O professor supervisor é definido pelo cadastro do estudante.</p><% end %></aside></div>
