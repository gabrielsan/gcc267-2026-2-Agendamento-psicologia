<% content_for :title, "Consultas" %>
<header class="page-header"><div><span class="eyebrow">ATENDIMENTOS</span><h1>Consultas</h1><p>Uma visão organizada dos seus encontros.</p></div><% if policy(Consulta).create? %><%= link_to new_consulta_path, class: "btn btn-primary" do %><%= icone("mais") %> Nova consulta<% end %><% end %></header>
<%= turbo_frame_tag "lista_consultas", data: { turbo_action: "advance" } do %><section class="panel">
  <%= form_with url: consultas_path, method: :get, class: "filters", data: { turbo_frame: "lista_consultas" } do |f| %><div class="field filter-search"><%= f.label :busca, "Paciente" %><%= f.search_field :busca, value: params[:busca], placeholder: "Buscar pelo nome" %></div><div class="field"><%= f.label :data, "Data" %><%= f.date_field :data, value: params[:data] %></div><div class="field"><%= f.label :status, "Status" %><%= f.select :status, options_for_select(ApplicationHelper::STATUS.map { |k, v| [v, k] }, params[:status]), include_blank: "Todos os status" %></div><%= f.submit "Filtrar", class: "btn btn-primary" %><%= link_to "Limpar", consultas_path, class: "btn btn-secondary" %><% end %>
  <% if @consultas.any? %><div class="appointment-list"><%= render @consultas %></div><% else %><%= render "shared/empty", title: "Nenhuma consulta encontrada", message: "Tente outros filtros ou aguarde um novo agendamento." %><% end %>
  <%= render "shared/pagination" %></section><% end %>
