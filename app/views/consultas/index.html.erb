<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
  <div>
    <h1 class="text-2xl font-semibold">Agenda de consultas</h1>
    <p class="mt-1 text-sm text-slate-500">Acompanhamento de horários, supervisores e status clínico.</p>
  </div>
  <% if estagiario_actor? %>
    <%= link_to "Nova consulta", new_consulta_path, class: "inline-flex rounded-md bg-teal-700 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" %>
  <% end %>
</div>

<div class="overflow-hidden rounded-md border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Paciente</th>
        <th class="px-4 py-3">Horário</th>
        <th class="px-4 py-3">Professor</th>
        <th class="px-4 py-3">Estagiário</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @consultas.each do |consulta| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3 font-medium text-slate-950"><%= consulta.patient_name %></td>
          <td class="px-4 py-3 text-slate-600"><%= l consulta.starts_at, format: :short %></td>
          <td class="px-4 py-3 text-slate-600"><%= consulta.professor.name %></td>
          <td class="px-4 py-3 text-slate-600"><%= consulta.estagiario.name %></td>
          <td class="px-4 py-3"><span class="rounded-full bg-teal-50 px-2 py-1 text-xs font-semibold text-teal-800"><%= consulta.status.humanize %></span></td>
          <td class="px-4 py-3 text-right"><%= link_to "Abrir", consulta, class: "font-semibold text-teal-700 hover:text-teal-900" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
