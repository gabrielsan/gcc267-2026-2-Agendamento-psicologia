<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
  <div>
    <h1 class="text-2xl font-semibold">Professores supervisores</h1>
    <p class="mt-1 text-sm text-slate-500">Equipe disponível para supervisão clínica.</p>
  </div>
  <% if admin_actor? %>
    <%= link_to "Novo professor", new_professor_path, class: "inline-flex rounded-md bg-teal-700 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" %>
  <% end %>
</div>

<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% @professores.each do |professor| %>
    <%= link_to professor, class: "rounded-md border border-slate-200 bg-white p-5 hover:border-teal-300 hover:shadow-sm" do %>
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="font-semibold text-slate-950"><%= professor.name %></h2>
          <p class="mt-1 text-sm text-slate-500"><%= professor.specialty.presence || "Psicologia" %></p>
        </div>
        <span class="rounded-full px-2 py-1 text-xs font-semibold <%= professor.active? ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500' %>"><%= professor.active? ? "Ativo" : "Inativo" %></span>
      </div>
      <div class="mt-4 text-sm text-slate-600"><%= professor.email %></div>
      <div class="mt-1 text-sm text-slate-500">CRP <%= professor.crp %></div>
    <% end %>
  <% end %>
</div>
