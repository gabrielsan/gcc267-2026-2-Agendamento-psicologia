<% content_for :title, "Cadastro do professor" %><%= link_to "← Voltar ao painel", painel_path, class: "back-link" %><header class="page-header"><div><span class="eyebrow">EQUIPE DA CLÍNICA</span><h1><%= @professor.nome %></h1><p>Professor supervisor</p></div><span class="badge <%= @professor.ativo? ? 'badge-confirmada' : 'badge-cancelada' %>"><%= @professor.ativo? ? "Ativo" : "Inativo" %></span></header><section class="panel detail-panel"><%= render "shared/errors", messages: @erros %><dl class="detail-grid"><div><dt>E-mail</dt><dd><%= @professor.email %></dd></div><div><dt>Matrícula</dt><dd><%= @professor.matricula.presence || "Não informada" %></dd></div><div><dt>Telefone</dt><dd><%= @professor.telefone.presence || "Não informado" %></dd></div><div><dt>Estudantes supervisionados</dt><dd><%= @professor.estagiarios.count %></dd></div></dl><div class="form-actions"><% if policy(@professor).update? %><%= link_to "Editar professor", edit_professor_path(@professor), class: "btn btn-primary" %><% end %><% if policy(@professor).destroy? %><%= button_to "Excluir professor", professor_path(@professor), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Excluir este professor? Cadastros com vínculos precisam ser desativados." } } %><% end %></div></section>
