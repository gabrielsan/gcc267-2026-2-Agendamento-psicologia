<div class="mx-auto max-w-3xl rounded-md border border-slate-200 bg-white p-6">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-teal-700"><%= @professor.active? ? "Ativo" : "Inativo" %></p>
      <h1 class="mt-2 text-2xl font-semibold"><%= @professor.name %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= @professor.specialty.presence || "Psicologia" %></p>
    </div>
    <% if admin_actor? %>
      <div class="flex gap-2">
        <%= link_to "Editar", edit_professor_path(@professor), class: "rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold hover:bg-slate-50" %>
        <%= button_to "Excluir", @professor, method: :delete, class: "rounded-md bg-rose-600 px-3 py-2 text-sm font-semibold text-white hover:bg-rose-700" %>
      </div>
    <% end %>
  </div>
  <dl class="mt-8 grid gap-4 sm:grid-cols-2">
    <div><dt class="text-sm text-slate-500">E-mail</dt><dd class="mt-1 font-medium"><%= @professor.email %></dd></div>
    <div><dt class="text-sm text-slate-500">CRP</dt><dd class="mt-1 font-medium"><%= @professor.crp %></dd></div>
  </dl>
</div>
