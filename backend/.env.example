# Copie para .env e ajuste se necessário (o docker-compose lê este arquivo).

# Chave usada para assinar os tokens JWT. Gere com: bin/rails secret
DEVISE_JWT_SECRET_KEY=troque-por-uma-chave-gerada-com-rails-secret

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Validade do token em minutos
JWT_EXPIRATION_MINUTES=480
