# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore environment files.
/.env*
!/.env.example

# Ignore generated files.
/coverage/
/public/assets
/public/packs
/public/packs-test
/node_modules
/yarn-error.log
/yarn-debug.log*
/.yarn-integrity

# Ignore Rails runtime files.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep

# Ignore local credentials and database dumps.
/config/master.key
*.dump
